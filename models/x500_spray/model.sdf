<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_spray'>
    <include merge='true'>
      <uri>model://x500_base</uri>
    </include>

    <!-- ================================================================
         Spray payload: a dummy tank + a nozzle link, rigidly fixed under
         base_link. The nozzle link's +X axis is the spray direction; it is
         rotated pitch +90deg so +X points straight down (-Z).

         NOTE (dummy geometry): the tank is a plain box and the nozzle has no
         visual for now. To use the real spray-gun mesh later, drop
         spray_gun.glb into this model's meshes/ dir, replace the tank <box>
         visual with a <mesh> uri, and tune the nozzle_joint offset to the
         mesh's actual nozzle tip. Also revisit the tank mass below once the
         payload is real.
         ================================================================ -->
    <link name="spray_tank_link">
      <pose relative_to="base_link">0 0 -0.06 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="spray_tank_visual">
        <geometry>
          <box>
            <size>0.09 0.09 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="spray_nozzle_link">
      <!-- Just below the tank, pitched so +X (spray axis) points down. -->
      <pose relative_to="spray_tank_link">0 0 -0.05 0 1.5707963 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="spray_tank_joint" type="fixed">
      <parent>base_link</parent>
      <child>spray_tank_link</child>
    </joint>

    <joint name="spray_nozzle_joint" type="fixed">
      <parent>spray_tank_link</parent>
      <child>spray_nozzle_link</child>
    </joint>

    <!-- Motor plugins (identical to the stock x500) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="MotorFailurePlugin"
      name="gz::sim::systems::MotorFailureSystem">
    </plugin>

    <!-- Spray paint system plugin (built by src/modules/simulation/gz_plugins) -->
    <plugin filename="SprayPaintPlugin"
      name="gz::sim::systems::SprayPaintPlugin">
      <nozzle_link>spray_nozzle_link</nozzle_link>
      <!-- Ground surface the patches attach to. Whitespace-separated candidate
           link names, tried in order; the first that exists outside the drone's
           own model wins. The raycast reports no hit entity, so the surface
           cannot be auto-detected and must be named.
             link             -> spray_range.sdf (ground_plane)
             environment_link -> an_giang.sdf    (terrain mesh) -->
      <ground_link>link environment_link</ground_link>
      <!-- Half-angle sets the swath: 2 * h * tan(angle). 40 deg gives a ~5.0 m
           swath at a 3 m pass, matching real agricultural sprayers. The earlier
           15 deg gave only 1.6 m, which concentrated the flow ~3x and pushed
           every mission past the design doc's over-spray threshold no matter
           how it was flown. Changing this rescales deposition by 1/tan^2, so
           re-check flow_rate_lpm below whenever it moves. -->
      <cone_half_angle_deg>40</cone_half_angle_deg>
      <cone_max_range>3.0</cone_max_range>
      <spray_color>1.0 0.2 0.1 1.0</spray_color>
      <!-- Crop-spray look (RGBA, 0-1): a visible light-grey mist in the air,
           and a translucent near-black ground patch that darkens the surface
           (wet look) while keeping its hue. Both default to spray_color if
           omitted. -->
      <particle_color>0.75 0.75 0.75 0.5</particle_color>
      <patch_color>0.0 0.0 0.0 0.4</patch_color>
      <spray_topic>/spray_paint/trigger</spray_topic>
      <particle_rate>100</particle_rate>
      <!-- Ground cell pitch: at most one patch visual per cell, so the entity
           count is bounded by sprayed area / patch_spacing^2 rather than by
           spray duration. Halving this quadruples the patch count. -->
      <patch_spacing>0.5</patch_spacing>
      <!-- How far the patch disc is pushed off the surface along its normal (m).
           0.0015 = half the disc thickness, enough to stop z-fighting on a
           surface the probe hit exactly. Correct for spray_range, whose ground
           plane is both the collision and the visual surface.

           Raise it where the rendered surface is NOT the surface the probe hit.
           In an_giang the collision proxy sits below the visual mesh (median
           -408 mm), so patches are buried; ~0.45 surfaces roughly half of them.
           Purely visual - physics and the recorded cell are unaffected. -->
      <!-- <patch_lift>0.0015</patch_lift> -->
      <patch_lift>0.45</patch_lift> <!-- an_giang -->
      <paint_interval_steps>10</paint_interval_steps>
      <!-- Airborne mist is the dominant render cost and adds nothing to the
           deposition model; the ground patches carry the "sprayed" signal. -->
      <enable_particle_emitter>false</enable_particle_emitter>
      <!-- Deposition model (see ~/UAV/docs/spray_simulation_design.md S2).
           Each scan deposits  Q * eta * dt / (pi * R^2)  ml/m^2 over the cone
           footprint, R being the cone radius at the probe hit. Flying higher
           widens the cone and thins the deposit, so altitude is handled without
           a separate term.

           Q is paired with cone_half_angle_deg above: 1.7 L/min over the 5.0 m
           swath at h=3 m, v=5 m/s deposits ~1.0 ml/m^2, mid-way between the
           design doc's D_min=0.5 and D_max=1.5, so a clean pass scores on
           target and both under- and over-spray remain reachable.

           The doc quotes 5 L/min, which assumes the 4-6 m swath of a real
           sprayer. Only lift Q back toward that once the swath is that wide;
           at a narrower cone the same flow grades as pure over-spray. -->
      <flow_rate_lpm>1.7</flow_rate_lpm>
      <deposition_efficiency>0.7</deposition_efficiency>
      <!-- Ground truth grid for deposition tracking (optional).
           Path supports ~ expansion for $HOME. If specified, drone position
           and spray coverage are accumulate into grid cells for validation.
           See ~/UAV/docs/spray-footprint-modeling.md for velocity constraints. -->
      <ground_truth_grid>~/UAV/spray_simulation/ground_truth_grid.json</ground_truth_grid>
      <!-- Re-export the deposition report every N seconds of sim time while
           spray is active, so it can be tailed mid-mission for debugging.
           Dose itself is never gated by this - every scan accumulates
           regardless - this only controls how often the JSON on disk is
           refreshed. The report is always written when spray toggles off and
           again on clean shutdown, independent of this interval. <=0 disables
           the periodic refresh (those two triggers still apply). -->
      <grid_export_interval_sec>5.0</grid_export_interval_sec>
    </plugin>
  </model>
</sdf>
