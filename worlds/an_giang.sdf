<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <!--
    An Giang v6 (green season, connection-safe) rice-field terrain.

    Renamed from 'an-giang-v6-season-green-connection-safe' to 'an_giang':
    px4-rc.gzsim loads worlds/${PX4_GZ_WORLD}.sdf and addresses gz topics as
    /world/${PX4_GZ_WORLD}/..., so the file name and <world name> must match.

    Mesh assets are NOT vendored here (~152 MB). Point Gazebo at them before
    launching:
      export GZ_SIM_RESOURCE_PATH=/home/anvu/UAV/gz/models:$GZ_SIM_RESOURCE_PATH
    gz_env.sh appends to GZ_SIM_RESOURCE_PATH rather than overwriting it, so an
    externally exported path survives.

    The bullet collision detector is required: SprayPaintPlugin probes the
    ground with a raycast, and DART's default 'ode' detector does not support
    ray intersection (it warns "Raycast is not supported by 'ode'" and deposits
    no paint).
  -->
  <world name="an_giang">
    <physics name="skytrack_4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>-0.35 0.25 -0.9</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <intensity>1.1</intensity>
      <attenuation>
        <range>2000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>10.46637489</latitude_deg>
      <longitude_deg>104.80105089</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <model name="an-giang-v6-season-green-connection-safe-environment">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="environment_link">
        <!--
          Do NOT lift these collision meshes to compensate for the fact that
          they sit ~0.4 m below the visual surface (see the plugin README,
          "Open gap: patches invisible on curved terrain"). That was tried and
          reverted: the vehicle spawns at z~0 on spawn_support_link, so raising
          the terrain collision above it leaves the drone underneath the ground
          and unable to take off.

          Use the plugin's <patch_lift> parameter instead - it moves only the
          patch visual and leaves physics untouched.
        -->
        <collision name="terrain_collision">
          <geometry>
            <mesh>
              <uri>model://an-giang-v6-season-green-connection-safe/meshes/collision_terrain_connection_safe.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <collision name="canal_bank_collision">
          <geometry>
            <mesh>
              <uri>model://an-giang-v6-season-green-connection-safe/meshes/collision_canal_banks.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://an-giang-v6-season-green-connection-safe/meshes/model.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="proxy_tree_0">
          <pose>165.500000 432.720001 4.853897 0 0 0</pose>
